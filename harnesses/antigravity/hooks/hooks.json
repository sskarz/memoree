{
  "memoree": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/bundle/pre-invocation.js\" PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bundle/pre-tool-use.js\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bundle/capture.js\" PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/bundle/stop.js\" Stop",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/bundle/graph-on-stop.js\" Stop",
        "timeout": 30
      }
    ]
  }
}
