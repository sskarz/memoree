{
  "name": "@sskarz/memoree",
  "version": "0.7.150",
  "description": "Local-first persistent memory for Claude Code, Codex, and Antigravity",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sskarz/memoree.git"
  },
  "bin": {
    "memoree": "bundle/cli.js"
  },
  "files": [
    "bundle/",
    "harnesses/claude-code/",
    "harnesses/codex/",
    "harnesses/antigravity/",
    "embeddings/",
    ".claude-plugin/",
    "scripts/ensure-tree-sitter.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-versions.mjs && node scripts/clean-build.mjs",
    "build": "tsc && node esbuild.config.mjs",
    "bundle": "node esbuild.config.mjs",
    "dev": "tsc --watch",
    "shell": "tsx src/shell/memoree-shell.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dup": "jscpd src",
    "check:legacy": "node scripts/check-legacy-names.mjs",
    "check:runtime": "tsc --noEmit --allowJs --checkJs --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck --ignoreConfig --types node --noImplicitAny false scripts/runtime-validate.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm run check:runtime && npm run pack:check && vitest run --config vitest.source.config.ts",
    "runtime:init": "node scripts/runtime-manager.mjs init",
    "runtime:promote": "node scripts/runtime-manager.mjs promote",
    "runtime:rollback": "node scripts/runtime-manager.mjs rollback",
    "runtime:validate": "node scripts/runtime-validate.mjs",
    "live:e2e": "node scripts/live-session-e2e.mjs",
    "rebuild:native": "node scripts/ensure-tree-sitter.mjs",
    "ci": "npm run check:legacy && npm run verify && npm run dup",
    "postinstall": "node scripts/ensure-tree-sitter.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "just-bash": "^2.14.0",
    "pg": "^8.23.0",
    "yargs-parser": "^22.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.23.2",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "overrides": {
    "tree-sitter-c": "0.23.2",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-rust": "0.23.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@types/pg": "^8.21.0",
    "@types/yargs-parser": "^21.0.3",
    "@vitest/coverage-v8": "^4.1.3",
    "esbuild": "^0.28.0",
    "jscpd": "^4.0.9",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
